# Local variables and secrets for `pnpm dev`.
# Copy this file to `.dev.vars` and fill in the values. `.dev.vars` is gitignored.
# In production, set the same names in the Cloudflare dashboard
# (Workers & Pages → taste → Settings → Variables and Secrets) or with
# `wrangler secret put <NAME>`.

# The only Google account allowed to sign in. Any other account is rejected.
OWNER_EMAIL=you@example.com

# Public URL of the site, without a trailing slash. Google redirects to
# `<BETTER_AUTH_URL>/api/auth/callback/google`.
# Locally (http on localhost or 127.0.0.1), sign-in follows the dev server's
# origin instead, so any port works; Google still accepts only the redirect URIs
# registered on its client.
BETTER_AUTH_URL=http://localhost:3000

# Random secret that signs sessions, at least 32 characters.
# Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more

# OAuth client from Google Cloud Console → APIs & Services → Credentials
# (type "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional public contact page or mailto: address for takedown requests.
CONTACT_URL=

# Optional OAuth proxy for trusted Previews; keep blank for direct local sign-in.
# Configure Preview values in wrangler.jsonc and Preview-only secrets in Cloudflare.
OAUTH_PROXY_URL=
AUTH_PREVIEW_HOST=

# Optional password for the test login at `/test-login`, used by e2e and
# automated verification to sign in as the owner without Google. It works only
# when BETTER_AUTH_URL is http on localhost or 127.0.0.1 and no OAuth proxy is
# set, and needs at least 24 characters. Generate one with
# `openssl rand -hex 24`. Never set it in production or on Previews.
TEST_LOGIN_PASSWORD=
