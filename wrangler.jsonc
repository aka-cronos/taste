{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taste",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "preview_urls": true,
  "vars": { "CONTACT_URL": "" },
  "observability": {
    "enabled": true
  },
  // Self-hosters: change the pattern to your own domain, or remove `routes`
  // to serve from workers.dev only.
  "routes": [
    {
      "pattern": "taste.akacronos.com",
      "custom_domain": true
    }
  ],
  // Production resources are provisioned on first deploy and reused afterwards.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taste",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "taste-images"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "taste-preview",
        "database_id": "d4f75dd5-6b5a-4fca-8109-917861653507",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "taste-images-preview"
      }
    ]
  }
}
