{
  "name": "taste",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/seed.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint": "biome check --formatter-enabled=false .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.22",
    "@better-auth/core": "1.7.22",
    "@better-auth/mcp": "1.7.22",
    "@better-auth/oauth-provider": "1.7.22",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "entities": "^9.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
