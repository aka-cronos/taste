{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!**/routeTree.gen.ts",
      "!worker-configuration.d.ts",
      "!src/components/ui",
      "!src/lib/utils.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "performance": {
        // Inline handlers on JSX props are standard in React and Base UI.
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // Plain JS: types inferred from literal data make every optional field
      // look always-present.
      "includes": ["scripts/**"],
      "linter": {
        "rules": { "suspicious": { "noUnnecessaryConditions": "off" } }
      }
    },
    {
      // TanStack Router names splat and param routes with `$` (e.g. `$.ts`).
      "includes": ["src/routes/**"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
